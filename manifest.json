{
  "manifest_version": 3,
  "name": "GrayTTS",
  "version": "1.13",
  "version_name": "1.13 (2026-08-14 03:07)",
  "permissions": [
    "tts",
    "contextMenus",
    "storage",
    "offscreen",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ],
  "commands": {
    "read_selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Read selected text with GrayTTS"
    }
  }
}